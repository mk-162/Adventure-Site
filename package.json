{
  "name": "adventure-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=579",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "db:import": "tsx scripts/import-content.ts",
    "db:import-all": "tsx scripts/import-all.ts",
    "db:import-itineraries": "tsx scripts/import-json-itineraries.ts",
    "db:import-journal": "tsx scripts/import-journal-articles.ts",
    "build:climate": "tsx scripts/build-climate-data.ts",
    "audit:content": "tsx scripts/content-gap-audit.ts",
    "research:queue": "tsx scripts/deep-research-runner.ts",
    "research:prompts": "tsx scripts/deep-research-runner.ts --export",
    "youtube:fetch": "tsx scripts/youtube-fetch.ts",
    "youtube:preview": "tsx scripts/youtube-fetch.ts --dry-run --verbose",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "audit:all": "npm audit --audit-level=moderate",
    "deps:tree": "npm ls --all --depth=2"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.0.2",
    "@vercel/blob": "2.1.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "csv-parse": "6.1.0",
    "csv-stringify": "6.6.0",
    "drizzle-orm": "0.45.2",
    "jose": "6.1.3",
    "js-yaml": "4.1.1",
    "leaflet": "1.9.4",
    "lucide-react": "0.563.0",
    "next": "16.2.6",
    "openai": "6.18.0",
    "radix-ui": "1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-leaflet": "5.0.0",
    "react-markdown": "10.1.0",
    "resend": "6.12.3",
    "sharp": "0.34.5",
    "stripe": "20.3.0",
    "tailwind-merge": "3.4.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.18",
    "@types/js-yaml": "4.0.9",
    "@types/leaflet": "1.9.21",
    "@types/node": "20.19.31",
    "@types/react": "19.2.10",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "dotenv": "17.2.3",
    "drizzle-kit": "0.31.8",
    "eslint": "9.39.2",
    "eslint-config-next": "16.1.6",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "lint-staged": "16.4.0",
    "shadcn": "3.8.4",
    "tailwindcss": "4.1.18",
    "tsx": "4.21.0",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vitest": "4.1.6"
  },
  "overrides": {
    "postcss": "8.5.10"
  }
