# ─── Database ────────────────────────────────────────────────────────────────
# Runtime code expects DATABASE_URL.  Usually the same as POSTGRES_URL (Neon).
DATABASE_URL=

# Vercel Postgres / Neon-compatible variables (provisioned automatically on Vercel)
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NO_SSL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# ─── Auth / Admin ─────────────────────────────────────────────────────────────
# Admin passwords are now per-user scrypt hashes in the admin_users table —
# set via `npx tsx scripts/set-admin-password.ts <email>`.

# Still used as a JWT-signing fallback and as the events-ingest guard.
ADMIN_SECRET=

# Secret used to sign/verify admin JWTs.  Must be set in production.
JWT_SECRET=

# Dev only: set to "1" to bypass admin auth when ADMIN_PASSWORD is not set.
# NEVER set in production.
ALLOW_OPEN_ADMIN_DEV=

# ─── MCP API ──────────────────────────────────────────────────────────────────
# Bearer token required for POST /api/mcp tools/call requests.
MCP_API_KEY=

# ─── Email ───────────────────────────────────────────────────────────────────
RESEND_API_KEY=

# ─── File Storage ────────────────────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=

# ─── Stripe ──────────────────────────────────────────────────────────────────
# One env var per tier — this is the only pair read anywhere in the code
# (src/lib/stripe.ts STRIPE_PRICES). Do not add STRIPE_VERIFIED_PRICE_ID back;
# the "Enhanced" Stripe product maps to the "verified" DB tier via
# STRIPE_ENHANCED_PRICE_ID.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_ENHANCED_PRICE_ID=
STRIPE_PREMIUM_PRICE_ID=

# ─── Google OAuth ────────────────────────────────────────────────────────────
# All three must be set together; NEXT_PUBLIC_GOOGLE_LOGIN=1 shows the
# "Continue with Google" button on /login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_LOGIN=

# ─── AI / Third-party APIs ───────────────────────────────────────────────────
EVENTBRITE_TOKEN=

# Booking.com affiliate ID — accommodation links earn no commission without it.
BOOKING_AFFILIATE_ID=

# Google APIs key (Places ratings, operator discovery scripts)
GOOGLE_API_KEY=

# Perplexity API key (research scripts: scripts/research-utils.ts and friends)
PERPLEXITY_API_KEY=

# YouTube Data API key (scripts/youtube-fetch.ts)
YOUTUBE_API_KEY=

# ─── Site config ─────────────────────────────────────────────────────────────
# REQUIRED in production. Unset values fall back to the *.vercel.app deployment
# URL (wrong domain for OG/canonical URLs, emails, and Stripe redirects).
NEXT_PUBLIC_SITE_DOMAIN=adventurewales.co.uk
NEXT_PUBLIC_SITE_URL=https://adventurewales.co.uk
NEXT_PUBLIC_APP_URL=https://adventurewales.co.uk

# NODE_ENV is set automatically by Next.js / your runtime.  Do not set manually.
# NODE_ENV=development
