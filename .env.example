# ─── Database ────────────────────────────────────────────────────────────────
# Runtime code expects DATABASE_URL.  Usually the same as POSTGRES_URL (Neon).
DATABASE_URL=

# Vercel Postgres / Neon-compatible variables (provisioned automatically on Vercel)
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NO_SSL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# ─── Auth / Admin ─────────────────────────────────────────────────────────────
# Shared admin password — required in production.  Used to authenticate the
# /admin dashboard and issue JWTs via /api/auth/admin-login.
ADMIN_PASSWORD=

# Alternate env var name accepted in place of ADMIN_PASSWORD
ADMIN_SECRET=

# Secret used to sign/verify admin JWTs.  Must be set in production.
JWT_SECRET=

# Dev only: set to "1" to bypass admin auth when ADMIN_PASSWORD is not set.
# NEVER set in production.
ALLOW_OPEN_ADMIN_DEV=

# ─── MCP API ──────────────────────────────────────────────────────────────────
# Bearer token required for POST /api/mcp tools/call requests.
MCP_API_KEY=

# ─── Email ───────────────────────────────────────────────────────────────────
RESEND_API_KEY=

# ─── File Storage ────────────────────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=

# ─── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_VERIFIED_PRICE_ID=
STRIPE_PREMIUM_PRICE_ID=
STRIPE_ENHANCED_PRICE_ID=

# ─── Google OAuth ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── AI / Third-party APIs ───────────────────────────────────────────────────
OPENAI_API_KEY=
MET_OFFICE_API_KEY=
EVENTBRITE_TOKEN=

# ─── Site config ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_DOMAIN=adventurewales.com
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_APP_URL=

# NODE_ENV is set automatically by Next.js / your runtime.  Do not set manually.
# NODE_ENV=development
