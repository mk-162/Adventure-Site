# Database
# Runtime code expects DATABASE_URL. This can usually be the same value as Vercel/Neon POSTGRES_URL.
DATABASE_URL=

# Vercel Postgres / Neon-compatible variables
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NO_SSL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# App secrets
JWT_SECRET=
RESEND_API_KEY=
BLOB_READ_WRITE_TOKEN=

# Site Config
NEXT_PUBLIC_SITE_DOMAIN=adventurewales.com
NEXT_PUBLIC_APP_URL=
